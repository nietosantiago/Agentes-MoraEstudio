# Copiar a .env y completar. Nunca versionar .env.

# "local" = router por reglas y agentes determinísticos (sin API key, ideal para tests)
# "gemini" = router con structured output + agentes con loop de tools
MORA_LLM=local
GEMINI_API_KEY=
MORA_GEMINI_MODEL=gemini-2.5-flash
# Para estimar costo por corrida (USD por 1M tokens). Verificar precios vigentes.
MORA_PRECIO_INPUT_1M_USD=0.30
MORA_PRECIO_OUTPUT_1M_USD=2.50

# Debajo de este umbral de confianza el router pide aclaración
MORA_UMBRAL_ROUTER=0.60

# Vacío = SQLite local en MORA_RUNTIME_DIR. Para Postgres/Supabase:
# MORA_DATABASE_URL=postgresql://usuario:clave@host:5432/mora
MORA_DATABASE_URL=

# Fecha de referencia (vacío = hoy). Útil para demos y evaluación reproducible.
MORA_HOY=
MORA_RUNTIME_DIR=data/runtime
