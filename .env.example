# Copiar a .env y completar. Nunca versionar .env.
GEMINI_API_KEY=
# Modelo de Gemini a usar cuando MORA_LLM=gemini
MORA_GEMINI_MODEL=gemini-2.5-flash
# "local" = modo determinístico sin LLM (default, ideal para tests) | "gemini"
MORA_LLM=local
# Fecha de referencia para agenda/vencimientos (vacío = hoy). Formato YYYY-MM-DD
MORA_HOY=
# Directorio de estado operativo (checkpoints, ledger, outbox, memoria)
MORA_RUNTIME_DIR=data/runtime
